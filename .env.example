# Copy to .env and fill in. Never commit real values.

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── Database ─────────────────────────────────────────────────────────────────
MONGODB_URI=

# ── Server ───────────────────────────────────────────────────────────────────
# Should match the port the frontend dev server proxies to (see vite.config.js).
PORT=3000
NODE_ENV=development
