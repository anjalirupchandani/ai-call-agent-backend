# Copy to .env and fill in. Never commit real values.

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── Database ─────────────────────────────────────────────────────────────────
MONGODB_URI=

# ── Edesy Voice AI (server-side only) ────────────────────────────────────────
EDESY_API_KEY=          # needs scopes: calls, agents:write, functions:write
EDESY_AGENT_ID=
EDESY_WORKSPACE_ID=

# ── Knowledge Base voice tool ────────────────────────────────────────────────
# Public https URL of this backend (your ngrok URL, no trailing slash).
PUBLIC_BASE_URL=https://YOUR-SUBDOMAIN.ngrok-free.dev
# Random secret Edesy sends as X-Tool-Secret. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
KB_TOOL_SECRET=
# Optional: only for test calls NOT placed through this app (e.g. from the Edesy
# dashboard). Answers come from this user's Knowledge Base. Leave empty otherwise.
KB_FALLBACK_USER_ID=

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
